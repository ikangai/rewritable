autoresearch-results.tsv
.autoresearch-starred
debug/
scenario/
fix/
skill/
node_modules/
cli/seeds/
.worktrees/

# Local demo inputs — invoices / receipts / statements used as ad-hoc import
# fixtures. The tracked demo content lives under demo/html-effectiveness/;
# loose PDFs at the demo/ top level are personal financial documents and
# must never be committed.
demo/*.pdf

# macOS Finder metadata — never useful in version control.
.DS_Store

# Environment file holding local secrets (e.g. RWA_OPENROUTER_KEY). Never commit.
.env

# Published-snapshot storage for the service. The dir itself is tracked
# (via .gitkeep) so containers always have a writable path, but contents
# are local/operator state and must never enter version control.
service/data/*
!service/data/.gitkeep

# Local ad-hoc container that `tools/regenerate-refs.mjs` optionally writes
# alongside the tracked seed + references. Per CLAUDE.md it's "optional" —
# keep it out of version control so a fresh regen can't enter a commit.
/rewritable.html


# Local project kanban (kanban skill)
.kanban/

# Raw session-event log produced by Claude Code hooks for the diary skill.
# Per-machine state; the synthesized diary entries (*.md) are the canonical
# artifact and are tracked normally.
.dev-diary/.events.jsonl

# Loose root-level scratch/test rewritables generated during local work
# (ad-hoc `rwa new`/`import` outputs, rendered docs). Listed explicitly and
# anchored to root (leading /) so the tracked reference containers
# (hello.html, re-write-able-spec.html) and same-named files in subdirs
# (e.g. demo/invoice-tracker.html) are never shadowed.
/bp.html
/my-flow.html
/r9-workflow.html
/invoice-tracker.html
/architecture.html
/README.html
/kanban board.html

# Other loose root-level local scratch: FSA permission-probe artifacts, an
# import screenshot, and stray ad-hoc files. Local-only, never committed.
/.access-test
/.access-test2
/.import-current.png
/blog post about rewrtiable
/kanban board
